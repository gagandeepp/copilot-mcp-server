{
    "name": "@xxxx-devops-qa/copilot-mcp-server",
    "version": "2.0.0",
    "description": "MCP server to query GitHub Copilot usage across organizations",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "copilot-mcp-server": "dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsc --watch",
        "test": "npm run build && node --test test/*.test.mjs",
        "smoke": "node scripts/smoke.mjs",
        "prepublishOnly": "npm run build"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "keywords": [
        "mcp",
        "github",
        "copilot",
        "usage"
    ],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=20.3"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "^2.4.0",
        "dotenv": "^17.3.1",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "^2.4.0",
        "@types/node": "^25.5.0",
        "typescript": "^5.9.3"
    }
}
