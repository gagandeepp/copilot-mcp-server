{
    "servers": {
        "copilot-mcp-server": {
            "command": "node",
            "args": [
                "${workspaceFolder}/dist/index.js"
            ],
            "env": {
                "GITHUB_TOKEN": "${input:github-token}"
            }
        }
    },
    "inputs": [
        {
            "id": "github-token",
            "type": "promptString",
            "description": "GitHub Personal Access Token with manage_billing:copilot and read:org scopes",
            "password": true
        }
    ]
}
